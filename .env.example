# Admin panel credentials (change in production)
ADMIN_PASSWORD=admin123

# PostgreSQL (pgAdmin / local or hosted Neon / Supabase)
# Change USER and PASSWORD to your PostgreSQL login
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5433/fastprints"

# Optional: separate session token (defaults to ADMIN_PASSWORD)
# ADMIN_SESSION_TOKEN=your-long-random-token

# Customer account sessions (defaults to ADMIN_PASSWORD in dev)
# CUSTOMER_SESSION_SECRET=your-long-random-customer-secret

# Razorpay (https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx

# Razorpay webhook secret (Dashboard → Webhooks → create endpoint /api/orders/webhook)
# RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Email via Resend (https://resend.com) — free tier for order confirmations
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM_EMAIL=Fast Prints <orders@yourdomain.com>
OWNER_NOTIFICATION_EMAIL=fastprintsbtm@gmail.com

# Optional: WhatsApp Business API via Interakt (https://interakt.ai)
# When not set, customers get wa.me links instead of auto WhatsApp messages
# INTERAKT_API_KEY=your_interakt_api_key
